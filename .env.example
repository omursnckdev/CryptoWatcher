# Binance USDS-M Futures TESTNET anahtarları: https://testnet.binancefuture.com
# (GitHub ile giriş yapın -> "API Key" sekmesi). Gerçek Binance anahtarı KULLANMAYIN.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Telegram: @BotFather ile bot oluşturup token alın; chat id için bota mesaj yazıp
# https://api.telegram.org/bot<TOKEN>/getUpdates adresine bakın.
TELEGRAM_BOT_TOKEN=
# Özel sohbet için kendi id'niz (pozitif sayı); GRUP için grubun id'si (negatif sayı, -100... ile başlar).
# Bulmak için:  cryptowatcher telegram-id
TELEGRAM_CHAT_ID=
# Yalnızca grupta: /pause ve /resume komutlarını kullanabilecek kişilerin kullanıcı id'leri (virgülle ayırın).
# Boşsa grupta herkes sadece okuma komutlarını (/positions, /pnl, /status, /top) kullanabilir.
TELEGRAM_ALLOWED_USER_IDS=
