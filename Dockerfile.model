# Model shadow service: records LONG/SHORT decisions of a gradient-boosting model, never trades. Separate from the bot image.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 OMP_NUM_THREADS=1
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install ".[model]"
COPY config ./config
RUN useradd --create-home bot && mkdir -p /app/state && chown -R bot /app/state
USER bot
CMD ["cryptowatcher-model", "--state-dir", "/app/state", "run"]
